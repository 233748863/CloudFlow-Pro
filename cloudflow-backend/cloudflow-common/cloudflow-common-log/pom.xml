<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>cloudflow-common</artifactId>
        <groupId>com.cloudflow</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cloudflow-common-log</artifactId>
    <description>CloudFlow 操作日志模块 - 基于注解的操作日志自动记录，支持SPEL表达式、敏感字段脱敏、异步入库</description>

    <dependencies>
        <!-- 核心公共模块（UserContext、TenantContext等） -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-core</artifactId>
        </dependency>

        <!-- Redis模块（可选依赖，用于从sys_config读取日志配置） -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MyBatis-Plus（日志本地入库） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Web（提供 jakarta.servlet API、AOP 等，编译时需要） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring AOP（切面支持） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

</project>
