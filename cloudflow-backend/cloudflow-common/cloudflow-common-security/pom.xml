<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>cloudflow-common</artifactId>
        <groupId>com.cloudflow</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cloudflow-common-security</artifactId>
    <description>CloudFlow 公共安全模块 - Sa-Token、TokenService、@Inner 注解、SecurityUtils</description>

    <dependencies>
        <!-- 直接使用了 common-core 里的常量、上下文和响应对象 -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-core</artifactId>
        </dependency>

        <!-- 依赖 redis 模块（TokenService 需要 RedisCache） -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-redis</artifactId>
        </dependency>

        <!-- Spring Boot Web（provided，InnerAspect 需要 HttpServletRequest） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Sa-Token Servlet Starter（由各业务服务按需引入运行时能力） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Sa-Token Redis 持久化 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
