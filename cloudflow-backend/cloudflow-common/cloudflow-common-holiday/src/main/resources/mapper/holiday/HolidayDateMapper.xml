<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.common.holiday.mapper.HolidayDateMapper">
    <select id="selectCalendarYear" resultType="com.cloudflow.common.holiday.domain.HolidayDate">
        SELECT * FROM sys_holiday_date
        WHERE tenant_id = #{tenantId} AND calendar_id = #{calendarId} AND year_no = #{year} AND deleted = 0
    </select>
</mapper>
