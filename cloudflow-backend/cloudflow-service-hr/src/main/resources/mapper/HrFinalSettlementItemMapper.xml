<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.hr.mapper.HrFinalSettlementItemMapper">
    <select id="lock" resultType="java.lang.Long" flushCache="true" useCache="false">
        SELECT item_id FROM hr_final_settlement_item
        WHERE tenant_id = #{tenantId} AND item_id = #{identifier}
        FOR UPDATE
    </select>
</mapper>
