<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.hr.mapper.AttendanceRecordMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.cloudflow.hr.domain.entity.AttendanceRecord">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="employee_id" property="employeeId"/>
        <result column="attendance_date" property="attendanceDate"/>
        <result column="shift_id" property="shiftId"/>
        <result column="check_type" property="checkType"/>
        <result column="check_time" property="checkTime"/>
        <result column="check_method" property="checkMethod"/>
        <result column="location" property="location"/>
        <result column="status" property="status"/>
        <result column="process_instance_id" property="processInstanceId"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, tenant_id, employee_id, attendance_date, shift_id, check_type, check_time,
        check_method, location, status, process_instance_id, remark,
        create_time, update_time, create_by, update_by, deleted
    </sql>

    <!-- 查询员工某天的打卡记录 -->
    <select id="selectByEmployeeAndDate" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM hr_attendance_record
        WHERE deleted = 0
        AND employee_id = #{employeeId}
        AND attendance_date = #{attendanceDate}
        AND check_type = #{checkType}
        ORDER BY check_time DESC
        LIMIT 1
    </select>

    <!-- 查询员工某天的所有打卡记录 -->
    <select id="selectByEmployeeAndDateAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM hr_attendance_record
        WHERE deleted = 0
        AND employee_id = #{employeeId}
        AND attendance_date = #{attendanceDate}
        ORDER BY check_time ASC
    </select>

    <!-- 查询员工某个时间段的打卡记录 -->
    <select id="selectByEmployeeAndDateRange" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM hr_attendance_record
        WHERE deleted = 0
        AND employee_id = #{employeeId}
        AND attendance_date BETWEEN #{startDate} AND #{endDate}
        ORDER BY attendance_date ASC, check_time ASC
    </select>

</mapper>
