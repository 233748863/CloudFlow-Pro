<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.hr.mapper.HrLeavePeriodMapper">
    <select id="selectLocked" resultType="com.cloudflow.hr.domain.entity.HrLeavePeriod">
        SELECT * FROM hr_leave_period
        WHERE period_id = #{periodId} AND tenant_id = #{tenantId} AND deleted = 0
        FOR UPDATE
    </select>
</mapper>
