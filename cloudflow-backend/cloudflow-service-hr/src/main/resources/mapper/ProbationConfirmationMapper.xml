<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.hr.mapper.ProbationConfirmationMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.cloudflow.hr.domain.entity.ProbationConfirmation">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="application_no" property="applicationNo"/>
        <result column="employee_id" property="employeeId"/>
        <result column="probation_start_date" property="probationStartDate"/>
        <result column="probation_end_date" property="probationEndDate"/>
        <result column="expected_regular_date" property="expectedRegularDate"/>
        <result column="self_evaluation" property="selfEvaluation"/>
        <result column="manager_evaluation" property="managerEvaluation"/>
        <result column="process_instance_id" property="processInstanceId"/>
        <result column="status" property="status"/>
        <result column="reject_reason" property="rejectReason"/>
        <result column="extension_days" property="extensionDays"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, tenant_id, application_no, employee_id, probation_start_date, probation_end_date,
        expected_regular_date, self_evaluation, manager_evaluation, process_instance_id,
        status, reject_reason, extension_days, create_time, update_time, create_by, update_by, deleted
    </sql>

    <!-- 查询即将到期的试用期员工 -->
    <select id="selectExpiringProbations" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM hr_probation_confirmation
        WHERE tenant_id = #{tenantId}
        AND deleted = 0
        AND status = 'DRAFT'
        AND probation_end_date BETWEEN #{startDate} AND #{endDate}
        ORDER BY probation_end_date ASC
    </select>

</mapper>
