<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.hr.mapper.SalaryAdjustmentMapper">

    <!-- 结果映射 -->
    <resultMap id="SalaryAdjustmentVOMap" type="com.cloudflow.hr.domain.vo.SalaryAdjustmentVO">
        <id property="id" column="id"/>
        <result property="applicationNo" column="application_no"/>
        <result property="employeeId" column="employee_id"/>
        <result property="employeeName" column="employee_name"/>
        <result property="employeeNo" column="employee_no"/>
        <result property="adjustmentType" column="adjustment_type"/>
        <result property="adjustmentReason" column="adjustment_reason"/>
        <result property="beforeSalaryData" column="before_salary_data"/>
        <result property="afterSalaryData" column="after_salary_data"/>
        <result property="beforeTotal" column="before_total"/>
        <result property="afterTotal" column="after_total"/>
        <result property="adjustmentAmount" column="adjustment_amount"/>
        <result property="adjustmentRate" column="adjustment_rate"/>
        <result property="effectiveDate" column="effective_date"/>
        <result property="processInstanceId" column="process_instance_id"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <resultMap id="SalaryAdjustmentHistoryVOMap" type="com.cloudflow.hr.domain.vo.SalaryAdjustmentHistoryVO">
        <id property="id" column="id"/>
        <result property="applicationNo" column="application_no"/>
        <result property="adjustmentType" column="adjustment_type"/>
        <result property="adjustmentReason" column="adjustment_reason"/>
        <result property="beforeTotal" column="before_total"/>
        <result property="afterTotal" column="after_total"/>
        <result property="adjustmentAmount" column="adjustment_amount"/>
        <result property="adjustmentRate" column="adjustment_rate"/>
        <result property="effectiveDate" column="effective_date"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 查询调薪申请详情（包含员工信息） -->
    <select id="selectDetailById" resultMap="SalaryAdjustmentVOMap">
        SELECT
            sa.id,
            sa.application_no,
            sa.employee_id,
            e.name AS employee_name,
            e.employee_no,
            sa.adjustment_type,
            sa.adjustment_reason,
            sa.before_salary_data,
            sa.after_salary_data,
            sa.before_total,
            sa.after_total,
            sa.adjustment_amount,
            sa.adjustment_rate,
            sa.effective_date,
            sa.process_instance_id,
            sa.status,
            sa.create_time
        FROM hr_salary_adjustment sa
        LEFT JOIN hr_employee e ON sa.employee_id = e.id
        WHERE sa.id = #{id}
          AND sa.deleted = 0
    </select>

    <!-- 查询员工调薪历史 -->
    <select id="selectHistoryByEmployeeId" resultMap="SalaryAdjustmentHistoryVOMap">
        SELECT
            id,
            application_no,
            adjustment_type,
            adjustment_reason,
            before_total,
            after_total,
            adjustment_amount,
            adjustment_rate,
            effective_date,
            status,
            create_time
        FROM hr_salary_adjustment
        WHERE employee_id = #{employeeId}
          AND deleted = 0
          AND status IN ('APPROVED', 'EFFECTIVE')
        ORDER BY effective_date DESC, create_time DESC
    </select>

    <!-- 生成申请编号 -->
    <select id="generateApplicationNo" resultType="string">
        SELECT CONCAT('SA', DATE_FORMAT(NOW(), '%Y%m%d'), 
               LPAD(IFNULL(MAX(SUBSTRING(application_no, 11)), 0) + 1, 4, '0'))
        FROM hr_salary_adjustment
        WHERE application_no LIKE CONCAT('SA', DATE_FORMAT(NOW(), '%Y%m%d'), '%')
          AND deleted = 0
    </select>

</mapper>
