<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>cloudflow-backend</artifactId>
        <groupId>com.cloudflow</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cloudflow-service-hr</artifactId>
    <name>CloudFlow HR Service</name>
    <description>CloudFlow Pro HR 人力资源管理微服务</description>

    <dependencies>
        <!-- 注册与配置中心 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- Web 与安全 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>

        <!-- 远程调用 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
        </dependency>

        <!-- CloudFlow 公共模块 -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-data</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-datasource</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-excel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-oss</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-idempotent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-ratelimiter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-sensitive</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-encrypt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-workflow-callback</artifactId>
        </dependency>
        <!-- 配置敏感信息密文化（yaml 中 ENC(...) 占位的启动期解密） -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-config-secret</artifactId>
        </dependency>

        <!-- HR 模块直接使用的第三方库 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-quartz</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
        </dependency>

        <!-- 监控与运维 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- 开发辅助 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
