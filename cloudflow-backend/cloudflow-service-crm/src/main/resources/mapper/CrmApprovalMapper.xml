<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.crm.mapper.CrmApprovalMapper">
    <select id="lockById" resultType="com.cloudflow.crm.domain.CrmApproval">
        SELECT * FROM crm_approval WHERE approval_id = #{id} AND deleted = 0 FOR UPDATE
    </select>
</mapper>
