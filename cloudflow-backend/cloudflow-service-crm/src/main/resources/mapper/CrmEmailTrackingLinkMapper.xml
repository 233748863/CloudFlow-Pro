<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.crm.mapper.CrmEmailTrackingLinkMapper">
    <select id="selectByTokenHash" resultType="com.cloudflow.crm.domain.CrmEmailTrackingLink">
        SELECT * FROM crm_email_tracking_link WHERE token_hash = #{tokenHash}
    </select>
    <select id="selectForUpdate" resultType="com.cloudflow.crm.domain.CrmEmailTrackingLink">
        SELECT * FROM crm_email_tracking_link WHERE tenant_id = #{tenantId} AND link_id = #{linkId} FOR UPDATE
    </select>
</mapper>
