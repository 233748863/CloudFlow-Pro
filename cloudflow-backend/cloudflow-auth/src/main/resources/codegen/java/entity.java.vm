package ${entityPackage};

import com.baomidou.mybatisplus.annotation.IdType;
import com.baomidou.mybatisplus.annotation.TableId;
import com.baomidou.mybatisplus.annotation.TableName;
import com.baomidou.mybatisplus.annotation.FieldFill;
import com.baomidou.mybatisplus.annotation.TableField;
#if($table.versionFieldFlag == 1)
import com.baomidou.mybatisplus.annotation.Version;
#end
import com.fasterxml.jackson.annotation.JsonFormat;
import lombok.Data;

import java.io.Serializable;
#if($hasBigDecimal)
import java.math.BigDecimal;
#end
#if($hasLocalDate)
import java.time.LocalDate;
#end
#if($hasLocalDateTime)
import java.time.LocalDateTime;
#end
#if($hasLocalTime)
import java.time.LocalTime;
#end
#if($hasCollectionFields)
import java.util.List;
#end

/**
 * ${table.javaDocFunctionName}
 *
 * @author ${table.javaDocAuthor}
 */
@Data
@TableName("${table.tableName}")
public class ${ClassName} implements Serializable {
    private static final long serialVersionUID = 1L;

#if($pkColumn.incrementFlag == 1)
#if($pkColumn.columnMappingRequired)
    @TableId(value = "${pkColumn.columnName}", type = IdType.AUTO)
#else
    @TableId(type = IdType.AUTO)
#end
#else
#if($pkColumn.columnMappingRequired)
    @TableId("${pkColumn.columnName}")
#else
    @TableId
#end
#end
    private ${pkColumn.javaType} ${pkColumn.javaField};

#if($table.tenantFieldFlag == 1)
    private Long tenantId;

#end
#foreach($column in $businessColumns)
    /** ${column.javaDocColumnComment} */
#if($column.columnMappingRequired)
    @TableField("${column.columnName}")
#end
#if($column.javaType == 'LocalDateTime')
    @JsonFormat(pattern = "yyyy-MM-dd HH:mm:ss")
#elseif($column.javaType == 'LocalDate')
    @JsonFormat(pattern = "yyyy-MM-dd")
#elseif($column.javaType == 'LocalTime')
    @JsonFormat(pattern = "HH:mm:ss")
#end
    private ${column.javaType} ${column.javaField};

#end
#foreach($column in $betweenColumns)
    /** ${column.javaDocColumnComment}查询起始值。 */
    @TableField(exist = false)
    private ${column.javaType} begin${column.capJavaField};

    /** ${column.javaDocColumnComment}查询结束值。 */
    @TableField(exist = false)
    private ${column.javaType} end${column.capJavaField};

#end
#foreach($column in $inColumns)
    /** ${column.javaDocColumnComment}批量查询值。 */
    @TableField(exist = false)
    private List<${column.javaType}> ${column.javaField}List;

#end
#if($treeTemplate)
    /** 子节点，仅用于树形接口返回。 */
    @TableField(exist = false)
    private List<${ClassName}> children = new java.util.ArrayList<>();

#end
#if($table.logicDeleteFlag == 1)
    @TableField(fill = FieldFill.INSERT)
    private Integer deleted;

#end
#if($table.versionFieldFlag == 1)
    @Version
    private Integer version;

#end
#if($hasCreateBy)
    @TableField(fill = FieldFill.INSERT)
    private String createBy;

#end
#if($hasCreateTime)
    @JsonFormat(pattern = "yyyy-MM-dd HH:mm:ss")
    @TableField(fill = FieldFill.INSERT)
    private java.time.LocalDateTime createTime;

#end
#if($hasUpdateBy)
    @TableField(fill = FieldFill.INSERT_UPDATE)
    private String updateBy;

#end
#if($hasUpdateTime)
    @JsonFormat(pattern = "yyyy-MM-dd HH:mm:ss")
    @TableField(fill = FieldFill.INSERT_UPDATE)
    private java.time.LocalDateTime updateTime;
#end
}
