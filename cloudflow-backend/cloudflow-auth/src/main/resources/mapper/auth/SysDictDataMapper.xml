<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.auth.mapper.SysDictDataMapper">

    <select id="countDictReferences" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM ${tableName}
        WHERE ${columnName} = #{dictValue}
    </select>

</mapper>
