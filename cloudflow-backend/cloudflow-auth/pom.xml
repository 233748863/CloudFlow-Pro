<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>cloudflow-backend</artifactId>
        <groupId>com.cloudflow</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cloudflow-auth</artifactId>

    <dependencies>
        <!-- Nacos 服务发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>

        <!-- 公共安全模块（Sa-Token、TokenService、SecurityUtils） -->
        <!-- 传递依赖：common-security -> common-redis -> common-core -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-security</artifactId>
        </dependency>

        <!-- 配置敏感信息密文化（yaml 中 ENC(...) 占位的启动期解密） -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-config-secret</artifactId>
        </dependency>

        <!-- Auth 源码里直接使用了 common-core 的响应体、上下文与工具类 -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-core</artifactId>
        </dependency>

        <!-- Auth 源码里直接使用了 SensitiveUtils -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-sensitive</artifactId>
        </dependency>

        <!-- Auth 源码里直接使用了 Redis 相关公共工具 -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-data</artifactId>
        </dependency>

        <!-- 公共多数据源模块（包含 MyBatis-Plus、MySQL 驱动、dynamic-datasource） -->
        <!-- 通过 @DS("数据源名") 注解在 Mapper 层切换数据源 -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-datasource</artifactId>
        </dependency>

        <!-- 操作日志模块 -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-log</artifactId>
        </dependency>

        <!-- 审计日志模块 -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-job</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-ratelimiter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-idempotent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-statemachine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-event</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-workflow-callback</artifactId>
        </dependency>

        <!-- 文件存储模块（本地存储/MinIO/阿里云 OSS） -->
        <dependency>
            <groupId>com.cloudflow</groupId>
            <artifactId>cloudflow-common-oss</artifactId>
        </dependency>

        <!-- Auth 代码里直接使用了 Hutool、Redis API、JavaTimeModule 和 commons-lang3 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lionsoul</groupId>
            <artifactId>ip2region</artifactId>
            <version>2.7.0</version>
        </dependency>
        <dependency>
            <groupId>org.javers</groupId>
            <artifactId>javers-core</artifactId>
        </dependency>

        <!-- Prometheus 指标导出 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 单元测试 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
