<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.oa.mapper.OaPurchaseRfqSupplierMapper">
    <select id="selectForUpdate" resultType="com.cloudflow.oa.domain.OaPurchaseRfqSupplier">
        SELECT * FROM oa_purchase_rfq_supplier
        WHERE rfq_supplier_id = #{id} AND tenant_id = #{tenantId}
        FOR UPDATE
    </select>
</mapper>
