<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.oa.mapper.OaActivityCostMapper">
    <select id="selectForUpdate" resultType="com.cloudflow.oa.domain.OaActivityCost">
        SELECT * FROM oa_activity_cost
        WHERE cost_id = #{id} AND tenant_id = #{tenantId} AND deleted = 0
        FOR UPDATE
    </select>
</mapper>
