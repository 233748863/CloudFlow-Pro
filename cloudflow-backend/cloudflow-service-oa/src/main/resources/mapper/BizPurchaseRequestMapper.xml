<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.oa.mapper.BizPurchaseRequestMapper">

    <resultMap id="PurchaseRequestWithItemsMap" type="com.cloudflow.oa.domain.BizPurchaseRequest">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="instanceId" column="instance_id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="purchaseNo" column="purchase_no"/>
        <result property="supplierId" column="supplier_id"/>
        <result property="supplierName" column="supplier_name"/>
        <result property="supplierContact" column="supplier_contact"/>
        <result property="supplierPhone" column="supplier_phone"/>
        <result property="supplierBank" column="supplier_bank"/>
        <result property="supplierAccount" column="supplier_account"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="expectedDate" column="expected_date"/>
        <result property="reason" column="reason"/>
        <result property="status" column="status"/>
        <result property="paymentRequestId" column="payment_request_id"/>
        <result property="attachmentUrl" column="attachment_url"/>
        <result property="deptId" column="dept_id"/>
        <result property="deptName" column="dept_name"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <collection property="items" ofType="com.cloudflow.oa.domain.BizPurchaseItem">
            <id property="id" column="item_id"/>
            <result property="tenantId" column="item_tenant_id"/>
            <result property="purchaseId" column="purchase_id"/>
            <result property="consumableId" column="consumable_id"/>
            <result property="consumableName" column="consumable_name"/>
            <result property="model" column="model"/>
            <result property="unit" column="unit"/>
            <result property="quantity" column="quantity"/>
            <result property="unitPrice" column="unit_price"/>
            <result property="amount" column="item_amount"/>
            <result property="receivedQuantity" column="received_quantity"/>
        </collection>
    </resultMap>

    <select id="selectRequestWithItems" resultMap="PurchaseRequestWithItemsMap">
        SELECT
            r.*,
            i.id AS item_id,
            i.tenant_id AS item_tenant_id,
            i.purchase_id,
            i.consumable_id,
            i.consumable_name,
            i.model,
            i.unit,
            i.quantity,
            i.unit_price,
            i.amount AS item_amount,
            i.received_quantity
        FROM biz_purchase_request r
        LEFT JOIN biz_purchase_item i ON r.id = i.purchase_id
        WHERE r.id = #{id} AND r.del_flag = '0'
    </select>

</mapper>
