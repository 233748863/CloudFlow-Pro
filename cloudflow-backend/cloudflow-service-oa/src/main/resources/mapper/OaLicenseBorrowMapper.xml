<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.oa.mapper.OaLicenseBorrowMapper">

    <select id="selectPageByDataScope" resultType="com.cloudflow.oa.domain.OaLicenseBorrow">
        SELECT *
        FROM oa_license_borrow
        <where>
            <if test="query != null">
                <if test="query.licenseId != null">
                    AND license_id = #{query.licenseId}
                </if>
                <if test="query.userId != null">
                    AND user_id = #{query.userId}
                </if>
                <if test="query.status != null and query.status != ''">
                    AND status = #{query.status}
                </if>
                <if test="query.borrowNo != null and query.borrowNo != ''">
                    AND borrow_no LIKE CONCAT('%', #{query.borrowNo}, '%')
                </if>
                <if test="query.licenseName != null and query.licenseName != ''">
                    AND license_name LIKE CONCAT('%', #{query.licenseName}, '%')
                </if>
            </if>
            AND del_flag = '0'
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>
