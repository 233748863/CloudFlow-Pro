<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.oa.mapper.OaProjectMapper">
    <select id="selectForUpdate" resultType="com.cloudflow.oa.domain.OaProject">
        SELECT * FROM oa_project WHERE project_id = #{id} AND tenant_id = #{tenantId} AND deleted = 0 FOR UPDATE
    </select>
</mapper>
