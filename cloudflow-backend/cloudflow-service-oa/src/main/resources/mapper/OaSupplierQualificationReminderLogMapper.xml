<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.oa.mapper.OaSupplierQualificationReminderLogMapper">
    <select id="selectForUpdate" resultType="com.cloudflow.oa.domain.OaSupplierQualificationReminderLog">
        SELECT * FROM oa_supplier_qualification_reminder_log
        WHERE id = #{id} AND tenant_id = #{tenantId}
        FOR UPDATE
    </select>
</mapper>
