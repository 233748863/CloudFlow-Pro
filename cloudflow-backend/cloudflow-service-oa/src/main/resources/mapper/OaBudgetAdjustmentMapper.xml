<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.oa.mapper.OaBudgetAdjustmentMapper">

    <select id="selectPageByDataScope" resultType="com.cloudflow.oa.domain.OaBudgetAdjustment">
        SELECT a.*,
               p.dept_id AS dept_id,
               p.owner_id AS owner_id
        FROM oa_budget_adjustment a
                 INNER JOIN oa_budget_plan p ON p.budget_id = a.budget_id AND p.deleted = '0'
        <where>
            a.deleted = '0'
            <if test="query != null">
                <if test="query.budgetId != null">
                    AND a.budget_id = #{query.budgetId}
                </if>
                <if test="query.status != null and query.status != ''">
                    AND a.status = #{query.status}
                </if>
            </if>
        </where>
        ORDER BY a.update_time DESC
    </select>

</mapper>
