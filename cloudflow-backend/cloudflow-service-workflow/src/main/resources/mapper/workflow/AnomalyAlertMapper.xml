<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.workflow.mapper.AnomalyAlertMapper">

    <resultMap id="AnomalyAlertResult" type="com.cloudflow.workflow.domain.monitor.AnomalyAlert">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="instanceId" column="instance_id"/>
        <result property="taskId" column="task_id"/>
        <result property="processDefKey" column="process_def_key"/>
        <result property="processName" column="process_def_name"/>
        <result property="nodeKey" column="node_key"/>
        <result property="nodeName" column="node_name"/>
        <result property="anomalyType" column="anomaly_type"/>
        <result property="severity" column="severity"/>
        <result property="errorMessage" column="error_message"/>
        <result property="stackTrace" column="stack_trace"/>
        <result property="alertTime" column="alert_time"/>
        <result property="notificationSent" column="notification_sent"/>
        <result property="resolved" column="resolved"/>
        <result property="resolveNote" column="resolve_note"/>
        <result property="resolveTime" column="resolve_time"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="alertCount" column="alert_count"/>
    </resultMap>

    <sql id="AnomalyAlertColumns">
        aa.id,
        aa.tenant_id,
        aa.instance_id,
        aa.task_id,
        aa.process_def_key,
        aa.process_def_name,
        aa.node_key,
        aa.node_name,
        aa.anomaly_type,
        aa.severity,
        aa.error_message,
        aa.stack_trace,
        aa.alert_time,
        aa.notification_sent,
        aa.resolved,
        aa.resolve_note,
        aa.resolve_time,
        aa.create_time,
        aa.update_time
    </sql>

    <!-- 根据日期统计数量 -->
    <select id="countByDate" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM wf_anomaly_alert aa
        WHERE aa.create_time >= #{startDate}
    </select>

    <!-- 统计未解决的异常数量 -->
    <select id="countUnresolved" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM wf_anomaly_alert aa
        WHERE aa.resolved = 'N'
    </select>

    <!-- 查询异常告警列表 -->
    <select id="selectAnomalyAlerts" resultMap="AnomalyAlertResult">
        SELECT
            <include refid="AnomalyAlertColumns"/>
        FROM wf_anomaly_alert aa
        <where>
            <if test="anomalyType != null and anomalyType != ''">
                AND aa.anomaly_type = #{anomalyType}
            </if>
            <if test="severity != null and severity != ''">
                AND aa.severity = #{severity}
            </if>
            <if test="resolved != null">
                <choose>
                    <when test="resolved == true">
                        AND aa.resolved = 'Y'
                    </when>
                    <otherwise>
                        AND aa.resolved = 'N'
                    </otherwise>
                </choose>
            </if>
        </where>
        ORDER BY aa.alert_time DESC, aa.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="AnomalyAlertResult">
        SELECT
            <include refid="AnomalyAlertColumns"/>
        FROM wf_anomaly_alert aa
        WHERE aa.id = #{id}
    </select>

    <!-- 查询未解决异常告警 -->
    <select id="selectUnresolved" resultMap="AnomalyAlertResult">
        SELECT
            <include refid="AnomalyAlertColumns"/>
        FROM wf_anomaly_alert aa
        WHERE aa.tenant_id = #{tenantId}
          AND aa.resolved = 'N'
        ORDER BY aa.alert_time DESC, aa.create_time DESC
    </select>

    <!-- 按类型查询异常告警 -->
    <select id="selectByType" resultMap="AnomalyAlertResult">
        SELECT
            <include refid="AnomalyAlertColumns"/>
        FROM wf_anomaly_alert aa
        WHERE aa.tenant_id = #{tenantId}
          AND aa.anomaly_type = #{type}
        ORDER BY aa.alert_time DESC, aa.create_time DESC
    </select>

    <!-- 按严重程度查询异常告警 -->
    <select id="selectBySeverity" resultMap="AnomalyAlertResult">
        SELECT
            <include refid="AnomalyAlertColumns"/>
        FROM wf_anomaly_alert aa
        WHERE aa.tenant_id = #{tenantId}
          AND aa.severity = #{severity}
        ORDER BY aa.alert_time DESC, aa.create_time DESC
    </select>

    <!-- 按流程定义Key查询异常告警 -->
    <select id="selectByProcessDefKey" resultMap="AnomalyAlertResult">
        SELECT
            <include refid="AnomalyAlertColumns"/>
        FROM wf_anomaly_alert aa
        WHERE aa.tenant_id = #{tenantId}
          AND aa.process_def_key = #{processDefKey}
        ORDER BY aa.alert_time DESC, aa.create_time DESC
    </select>

    <!-- 查询异常类型统计 -->
    <select id="selectTypeStatistics" resultMap="AnomalyAlertResult">
        SELECT
            MIN(aa.id) AS id,
            aa.anomaly_type,
            COUNT(*) AS alert_count,
            MAX(aa.create_time) AS create_time
        FROM wf_anomaly_alert aa
        WHERE aa.tenant_id = #{tenantId}
          AND aa.create_time <![CDATA[>=]]> #{startDate}
          AND aa.create_time <![CDATA[<=]]> #{endDate}
        GROUP BY aa.anomaly_type
        ORDER BY alert_count DESC, aa.anomaly_type ASC
    </select>

    <!--
        updateById 使用 MyBatis-Plus 默认实现。
        原因：BaseMapper.updateById(entity) 的实体参数名为 et，
        手写同名 XML 会覆盖框架注入 SQL，并且容易漏掉 notificationSent、updateTime 等字段。
    -->

</mapper>
