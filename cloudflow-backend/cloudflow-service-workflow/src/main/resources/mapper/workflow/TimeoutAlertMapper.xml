<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.workflow.mapper.TimeoutAlertMapper">

    <resultMap id="TimeoutAlertResult" type="com.cloudflow.workflow.domain.monitor.TimeoutAlert">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="alertType" column="alert_type"/>
        <result property="targetId" column="target_id"/>
        <result property="targetName" column="target_name"/>
        <result property="timeoutLevel" column="timeout_level"/>
        <result property="timeoutDuration" column="timeout_duration"/>
        <result property="threshold" column="threshold"/>
        <result property="assigneeId" column="assignee_id"/>
        <result property="assigneeName" column="assignee_name"/>
        <result property="alertTime" column="alert_time"/>
        <result property="notificationSent" column="notification_sent"/>
        <result property="escalated" column="escalated"/>
        <result property="resolved" column="resolved"/>
        <result property="resolveTime" column="resolve_time"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 根据日期统计数量 -->
    <select id="countByDate" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM wf_timeout_alert
        WHERE alert_time >= #{startDate}
    </select>

    <!-- 根据告警级别统计数量 -->
    <select id="countByLevel" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM wf_timeout_alert
        WHERE timeout_level = #{alertLevel}
        AND (escalated = 'N' OR escalated IS NULL)
        AND tenant_id = 100000
    </select>

    <!-- 查询超时告警列表 -->
    <select id="selectTimeoutAlerts" resultMap="TimeoutAlertResult">
        SELECT 
            ta.id,
            ta.tenant_id,
            ta.alert_type,
            ta.target_id,
            ta.target_name,
            ta.timeout_level,
            ta.timeout_duration,
            ta.threshold,
            ta.assignee_id,
            ta.assignee_name,
            ta.alert_time,
            ta.notification_sent,
            ta.escalated,
            ta.resolved,
            ta.resolve_time,
            ta.create_time,
            ta.update_time
        FROM wf_timeout_alert ta
        <where>
            <if test="alertType != null and alertType != ''">
                AND ta.alert_type = #{alertType}
            </if>
            <if test="alertLevel != null and alertLevel != ''">
                AND ta.timeout_level = #{alertLevel}
            </if>
            <if test="resolved != null">
                <choose>
                    <when test="resolved == true">
                        AND ta.resolved = 'Y'
                    </when>
                    <otherwise>
                        AND (ta.resolved = 'N' OR ta.resolved IS NULL)
                    </otherwise>
                </choose>
            </if>
        </where>
        ORDER BY ta.alert_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="TimeoutAlertResult">
        SELECT 
            ta.id,
            ta.tenant_id,
            ta.alert_type,
            ta.target_id,
            ta.target_name,
            ta.timeout_level,
            ta.timeout_duration,
            ta.threshold,
            ta.assignee_id,
            ta.assignee_name,
            ta.alert_time,
            ta.notification_sent,
            ta.escalated,
            ta.resolved,
            ta.resolve_time,
            ta.create_time,
            ta.update_time
        FROM wf_timeout_alert ta
        WHERE ta.id = #{id}
    </select>

    <!-- 更新告警 -->
    <!--
        updateById 使用 MyBatis-Plus 默认实现。
        原因：BaseMapper.updateById(entity) 的实体参数名为 et，
        手写同名 XML 会覆盖框架注入 SQL，并且容易漏掉 timeoutLevel、resolved、updateTime 等字段。
    -->

</mapper>
