<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.workflow.mapper.WfTaskDelegationMapper">
    <select id="selectForUpdate" resultType="com.cloudflow.workflow.domain.WfTaskDelegation">
        SELECT * FROM wf_task_delegation
        WHERE tenant_id = #{tenantId} AND delegation_id = #{delegationId}
        FOR UPDATE
    </select>
</mapper>
