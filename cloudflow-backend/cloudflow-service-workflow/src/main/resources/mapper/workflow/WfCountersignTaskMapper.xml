<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.workflow.mapper.WfCountersignTaskMapper">
    <select id="selectForUpdate" resultType="com.cloudflow.workflow.domain.WfCountersignTask" useCache="false" flushCache="true">
        SELECT * FROM wf_countersign_task
        WHERE tenant_id = #{tenantId} AND countersign_id = #{countersignId}
        FOR UPDATE
    </select>
</mapper>
