<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudflow.workflow.mapper.WfDeployImpactMapper">

    <resultMap id="deployImpactMap" type="com.cloudflow.workflow.domain.WfDeployImpact" autoMapping="true">
        <id property="id" column="id"/>
        <result property="suggestion" column="mitigation_plan"/>
        <result property="createdTime" column="create_time"/>
    </resultMap>

    <select id="listByDeployId" resultMap="deployImpactMap">
        SELECT *
        FROM wf_deploy_impact
        WHERE deploy_id = #{deployId}
        ORDER BY impact_level DESC
    </select>

    <select id="listHighImpactByDeployId" resultMap="deployImpactMap">
        SELECT *
        FROM wf_deploy_impact
        WHERE deploy_id = #{deployId}
          AND impact_level IN ('HIGH', 'CRITICAL')
    </select>

</mapper>
