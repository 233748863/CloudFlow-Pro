<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.joywon.poco.merchant.PointsModule.mapper.PointsAccountMapper">


    <!--  批量删除积分账户
    int deletePointsAccounts(List<Long> ids)  -->
    <update id="deletePointsAccounts">

        UPDATE points_accounts
        SET is_deleted = 1, deleted_time = NOW(), is_enable = 0
        WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>

    </update>


</mapper>