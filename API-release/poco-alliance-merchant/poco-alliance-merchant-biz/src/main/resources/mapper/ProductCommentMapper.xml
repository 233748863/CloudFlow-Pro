<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.joywon.poco.merchant.CommentModule.mapper.ProductCommentMapper">

    <resultMap id="productCommentMap" type="cn.joywon.poco.merchant.CommentModule.entity.ProductComment">
        <id property="id" column="id"/>
        <result property="appUserId" column="app_user_id"/>
        <result property="userNickName" column="user_nick_name"/>
        <result property="userAvatar" column="user_avatar"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="storeId" column="store_id"/>
        <result property="orderId" column="order_id"/>
        <result property="orderItemId" column="order_item_id"/>
        <result property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <!-- 移除了不存在的 productImage 字段映射 -->
        <result property="skuId" column="sku_id"/>
        <!-- 修正了字段名 skuSpecs -> sku_spec -->
        <result property="skuSpec" column="sku_spec"/>
        <result property="star" column="star"/>
        <result property="content" column="content"/>
        <result property="images" column="images"/>
        <!-- 添加了缺失的 isAnonymous 字段映射 -->
        <result property="isAnonymous" column="is_anonymous"/>
        <result property="isShow" column="is_show"/>
        <result property="replyContent" column="reply_content"/>
        <result property="replyTime" column="reply_time"/>
        <result property="replyUserId" column="reply_user_id"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updatedTime" column="updated_time"/>
    </resultMap>

    <select id="pageMerchantComments" resultMap="productCommentMap">
        SELECT
            *
        FROM product_comment
        WHERE is_deleted = 0
        <if test="dto.storeId != null">
            AND store_id = #{dto.storeId}
        </if>
        <if test="dto.productId != null">
            AND product_id = #{dto.productId}
        </if>
        ORDER BY created_time DESC
    </select>

</mapper>