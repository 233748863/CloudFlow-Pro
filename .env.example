# CloudFlow Pro environment template
# Copy to .env and replace every placeholder before first startup.

MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD
MYSQL_APP_USERNAME=cloudflow
MYSQL_APP_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD
MYSQL_PORT=3306
MYSQL_SSL_PARAMS=useSSL=true&verifyServerCertificate=false&allowPublicKeyRetrieval=true
CLOUDFLOW_ENCRYPT_AES_KEY=REPLACE_WITH_16_24_OR_32_CHAR_AES_KEY
CLOUDFLOW_ENCRYPT_SM4_KEY=REPLACE_WITH_16_CHAR_SM4_KEY
CLOUDFLOW_ENCRYPT_ENABLED=false

REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

NACOS_SERVER=nacos:8848
NACOS_NAMESPACE=0ccb9313-39d8-4a58-9fa5-ce834b77e60d
NACOS_USERNAME=REPLACE_WITH_NACOS_USERNAME
NACOS_PASSWORD=REPLACE_WITH_NACOS_PASSWORD
NACOS_AUTH_TOKEN=REPLACE_WITH_32_PLUS_CHAR_TOKEN

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD
PROMETHEUS_SCRAPE_PASSWORD=REPLACE_WITH_STRONG_PROMETHEUS_SCRAPE_PASSWORD

SPRING_PROFILES_ACTIVE=prod

LOG_LEVEL_APP=INFO
LOG_LEVEL_MAPPER=WARN
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl

JWT_SECRET=REPLACE_WITH_32_PLUS_CHAR_SECRET
FILE_UPLOAD_PATH=/data/cloudflow/uploads
