# ============================================================
# CloudFlow Pro - 环境变量配置模板
# ============================================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据实际环境修改下面的配置值
# 3. .env 文件已在 .gitignore 中，不会被提交到 Git
# ============================================================

# ============================================================
# 数据库配置
# ============================================================
MYSQL_ROOT_PASSWORD=cloudflow_2026
# 生产环境建议使用强密码，至少16位，包含大小写字母、数字和特殊字符

MYSQL_PORT=3306
# MySQL 对外映射端口，避免与本地 MySQL 冲突时可修改

# ============================================================
# Redis 配置
# ============================================================
REDIS_PASSWORD=cloudflow_redis_2026
# 生产环境建议使用强密码

# ============================================================
# Nacos 配置
# ============================================================
NACOS_SERVER=nacos:8848
# Docker 内部使用服务名，本地开发使用 localhost:8848

NACOS_NAMESPACE=
# 命名空间ID，用于环境隔离
# 开发环境: dev
# 测试环境: test
# 生产环境: prod 或留空使用 public

NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
# Nacos 认证密钥，必须至少32位
# 生产环境务必修改为随机生成的强密钥

# ============================================================
# Spring 配置
# ============================================================
SPRING_PROFILES_ACTIVE=prod
# 可选值: dev, test, prod

# ============================================================
# 其他配置
# ============================================================
# JWT 密钥（如果使用）
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_here

# 文件上传路径
FILE_UPLOAD_PATH=/data/cloudflow/uploads

# 日志级别
LOG_LEVEL=INFO
# 可选值: TRACE, DEBUG, INFO, WARN, ERROR

# ============================================================
# Docker Compose 资源限制（可选）
# ============================================================
# 如需调整容器资源限制，请直接修改 docker-compose.yml 中的 deploy.resources

# ============================================================
# 开发环境示例配置
# ============================================================
# 如果是本地开发，可以使用以下配置：
# MYSQL_ROOT_PASSWORD=root
# MYSQL_PORT=3307
# REDIS_PASSWORD=
# NACOS_SERVER=localhost:8848
# NACOS_NAMESPACE=dev
# SPRING_PROFILES_ACTIVE=dev
# LOG_LEVEL=DEBUG
