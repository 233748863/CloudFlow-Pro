# CloudFlow bare-metal / systemd environment template
# Copy to /etc/cloudflow/cloudflow.env and replace placeholders.

SPRING_PROFILES_ACTIVE=prod

NACOS_SERVER=192.168.1.173:8848
NACOS_NAMESPACE=0ccb9313-39d8-4a58-9fa5-ce834b77e60d
NACOS_USERNAME=nacos
NACOS_PASSWORD=REPLACE_WITH_NACOS_PASSWORD

DB_URL=jdbc:mysql://192.168.1.173:3306/cloud_flow_db?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&verifyServerCertificate=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=cloudflow
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

REDIS_HOST=192.168.1.173
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

CLOUDFLOW_TOTP_ENABLED=false
TOTP_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY

MYSQL_SSL_PARAMS=useSSL=true&verifyServerCertificate=false&allowPublicKeyRetrieval=true
LOG_LEVEL_APP=INFO
LOG_LEVEL_MAPPER=WARN
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl

CLOUDFLOW_ENCRYPT_ENABLED=false
CLOUDFLOW_ENCRYPT_AES_KEY=
CLOUDFLOW_ENCRYPT_SM4_KEY=
